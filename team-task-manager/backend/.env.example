# PostgreSQL connection string (Railway provides this automatically as DATABASE_URL)
DATABASE_URL="postgresql://user:password@localhost:5432/team_task_manager?schema=public"

# JWT secret - use a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development

# CORS - comma separated list of allowed origins, or * to allow all
CORS_ORIGIN="*"
